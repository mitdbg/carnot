# AI Studio Gemini API key (required for all LLM calls). Create one at:
# https://aistudio.google.com/apikey  — used via the google-genai SDK, NOT Vertex/ADC.
GEMINI_API_KEY=
# GCP Vertex AI (required for all LLM calls).
# Set up locally with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional — route LLM generation through OpenRouter instead of the Gemini SDK.
# Set SKUNK_LLM_PROVIDER=openrouter, provide the key below, and set SKUNK_LLM_MODEL
# to a full OpenRouter model id (e.g. google/gemini-2.5-flash, qwen/qwen-2.5-72b-instruct).
# SKUNK_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# Strongly recommended — enables FRED API lookups (free key at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Strongly recommended — Tavily is the catch-all search tier for lookup_external (free 1000 searches/month at https://tavily.com)
TAVILY_API_KEY=

# Optional — corpus dirs for the U.S. Receipts & Expenditures corpus. pdf_dir = source
# PDFs (page rendering); parsed_json_dir = per-document parsed JSON the text accessors read.
# OFFICEQA_PDF_DIR=/Users/you/Downloads/us_receipts_expenditures_no_ocr
# OFFICEQA_PARSED_JSON_DIR=/Users/you/Downloads/parsed_JSONs
