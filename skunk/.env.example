# AI Studio Gemini API key (required for all LLM calls). Create one at:
# https://aistudio.google.com/apikey  — used via the google-genai SDK, NOT Vertex/ADC.
GEMINI_API_KEY=

# Strongly recommended — enables FRED API lookups (free key at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Strongly recommended — Tavily is the catch-all search tier for lookup_external (free 1000 searches/month at https://tavily.com)
TAVILY_API_KEY=

# Optional — overrides the default PDF corpus path used by prep/manifest.py
# OFFICEQA_PDF_DIR=/Users/you/Desktop/officeqa/treasury_bulletin_pdfs
