# OpenRouter — the default LLM provider (SKUNK_LLM_PROVIDER=openrouter). SKUNK_LLM_MODEL
# must be a full OpenRouter model id (e.g. google/gemini-2.5-flash, qwen/qwen-2.5-72b-instruct).
SKUNK_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Optional — auth for vLLM servers started with --api-key (the "vllm" provider; models are
# routed per call via the vllm_base_urls config map). Unset => the client sends the vLLM
# convention "EMPTY", which open (no --api-key) servers accept.
# VLLM_API_KEY=

# Strongly recommended — enables FRED API lookups (free key at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Strongly recommended — Tavily is the catch-all search tier for lookup_external (free 1000 searches/month at https://tavily.com)
TAVILY_API_KEY=

# Optional — corpus dirs for the U.S. Receipts & Expenditures corpus. pdf_dir = source
# PDFs (page rendering); parsed_json_dir = per-document parsed JSON the text accessors read.
# OFFICEQA_PDF_DIR=/Users/you/Downloads/us_receipts_expenditures_no_ocr
# OFFICEQA_PARSED_JSON_DIR=/Users/you/Downloads/parsed_JSONs
